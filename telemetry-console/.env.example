# ==============================================================================
# Project Sambandh Telemetry Console Environment Configuration
# ==============================================================================

# Option 1: Microsoft Windows Native TTS
# Zero configuration required! Uses built-in `window.speechSynthesis` (Swara, Madhur, Ravi, Neerja).

# Option 2: WhisperFlo Telephony & Neural Voice Streaming API (Optional)
# If provided, speech is streamed via WhisperFlo's neural pipeline.
# If omitted or offline, the app automatically falls back to Windows Natural Neural voices.
VITE_WHISPERFLO_API_KEY="your_whisperflo_api_key_here"
VITE_WHISPERFLO_ENDPOINT="https://api.whisperflo.ai/v1/audio/speech"

# Live Backend Telemetry Stream WebSocket/SSE (Optional - default uses high-fidelity simulation engine)
VITE_TELEMETRY_WS_URL="ws://localhost:8080/telemetry"
