# ==============================================================================
# Project Sambandh Simulation Credentials
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Google Gemini API (Required for Live Gemini 1.5 Pro Agent Reasoning)
# ------------------------------------------------------------------------------
# Get your free API key at: https://aistudio.google.com/
GEMINI_API_KEY="your_gemini_api_key_here"

# ------------------------------------------------------------------------------
# 2. Telegram Bot API (RECOMMENDED FOR LIVE DEMO & VIDEO RECORDING)
# ------------------------------------------------------------------------------
# Why Telegram? 
# - 100% free, instant, no sandbox expiration, sub-second delivery.
# - Supports clickable interactive inline buttons directly beneath messages.
#
# Quick 30-Second Setup:
# 1. Open Telegram, search for @BotFather, send /newbot, and follow prompts to get your Bot Token.
# 2. Search for @userinfobot on Telegram, send /start to get your numeric Chat ID.
# 3. Start your newly created bot (press "Start" in the chat with your bot).
TELEGRAM_BOT_TOKEN="your_telegram_bot_token_here"
TELEGRAM_CHAT_ID="your_telegram_chat_id_here"

# Notification Channel Selection: "telegram" (recommended), "whatsapp", or "both"
CAREGIVER_CHANNEL="telegram"

# ------------------------------------------------------------------------------
# 3. Twilio WhatsApp API (Optional Alternative)
# ------------------------------------------------------------------------------
# Sign up at: https://www.twilio.com/
TWILIO_ACCOUNT_SID="your_twilio_account_sid"
TWILIO_AUTH_TOKEN="your_twilio_auth_token"
TWILIO_WHATSAPP_NUMBER="whatsapp:+14155238886"
CAREGIVER_WHATSAPP_NUMBER="whatsapp:+91XXXXXXXXXX"